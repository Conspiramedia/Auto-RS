# ============================================================
# AUTO.RS — Шаблон переменных окружения
# Скопируйте этот файл в .env и подставьте реальные значения.
# ВАЖНО: сам .env добавлен в .gitignore и НЕ коммитится.
# ============================================================

# URL проекта Supabase (Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Публичный анонимный ключ (Settings → API → anon public).
# Безопасен для клиента ТОЛЬКО при включённом RLS — он у нас включён.
SUPABASE_ANON_KEY=your-anon-public-key
