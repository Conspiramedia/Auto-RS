# ============================================================
# AUTO.RS — Шаблон переменных окружения
# Скопируйте этот файл в .env и подставьте реальные значения.
# ВАЖНО: сам .env добавлен в .gitignore и НЕ коммитится.
# ============================================================

# URL проекта Supabase (Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Публичный анонимный ключ (Settings → API → anon public).
# Безопасен для клиента ТОЛЬКО при включённом RLS — он у нас включён.
SUPABASE_ANON_KEY=your-anon-public-key

# Базовый адрес сайта — ЗАПАСНОЕ значение на случай, если сервер почему-то не
# вернул site_url. Основной источник истины — таблица app_settings в Supabase
# (меняется без пересборки приложения: select public.set_site_base_url('...')).
# Ссылка на объявление: {SITE_BASE_URL}/car/{id}. Без завершающего слэша.
SITE_BASE_URL=https://your-domain.rs
