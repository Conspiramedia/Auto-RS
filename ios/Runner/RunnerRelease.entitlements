<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links для релизной сборки. Список доменов тот же, что в
	     Runner.entitlements — расходиться они не должны, иначе ссылки
	     работали бы в отладке и ломались в релизе. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:rsauto-rs.vercel.app</string>
	</array>

	<!-- production — боевые APNs. Отличие от Debug-файла: сборка из App Store
	     и TestFlight обязана использовать production, иначе устройство не
	     получит push-токен. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
