<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-иконка Android 8+. Система накладывает на неё маску своей
     формы (круг, сквиркл, капля), поэтому фон обязан быть сплошным, а
     значимая часть арта — в центральных 72 из 108 dp.

     Инсет у foreground убран: масштаб задан в самом PNG (см.
     scripts/generate-icons.mjs сайта). С двойным сжатием — инсетом
     здесь и полями внутри файла — знак оказывался мелким островком
     посреди синего круга. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
